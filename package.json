{
  "name": "node-bitbankcc",
  "version": "4.3.0",
  "description": "node-bitbankcc",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitbankinc/node-bitbankcc"
  },
  "engines": {
    "node": ">= 18.18.0"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist; tsc -p tsconfig.json",
    "ci:prettier": "npm run format -- --list-different",
    "ci:lint": "npm run lint",
    "format": "npm run lint -- --fix && prettier --config .prettierrc --write \"src/**/*.ts\"",
    "tsc": "rm -rf dist; tsc -p tsconfig.development.json",
    "lint": "node --max-old-space-size=8000 node_modules/.bin/eslint './src/**/*.ts'",
    "test": "NODE_ENV=test mocha src/**/*.test.ts --require ts-node/register --timeout 10000 --require intelli-espower-loader",
    "test:prod": "NODE_ENV=production mocha src/**/*.test.ts --require ts-node/register --timeout 10000 --require intelli-espower-loader",
    "prepare": "npm run build"
  },
  "ciNode": "8",
  "devDependencies": {
    "@types/config": "0.0.41",
    "@types/mocha": "5.2.7",
    "@types/node": "^12.20.55",
    "@types/power-assert": "1.5.0",
    "@types/readline-sync": "1.4.8",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "config": "3.3.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.0",
    "intelli-espower-loader": "1.1.0",
    "mocha": "^11.7.0",
    "power-assert": "1.6.1",
    "prettier": "^3.6.0",
    "readline-sync": "1.4.10",
    "ts-node": "8.10.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "axios": "^0.30.0"
  }
}
